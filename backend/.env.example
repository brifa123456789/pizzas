# ─── Base de datos MySQL ───────────────────────────────
# LOCAL (desarrollo):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=bellanapoli
# Pon "true" si tu MySQL gestionado exige conexion TLS (TiDB Cloud, Aiven, etc.)
DB_SSL=false

# PRODUCCION con TiDB Cloud Serverless (gratis, 25GB):
# Copia estos valores desde tidbcloud.com → tu cluster → "Connect"
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=tu_password_de_tidb
# DB_NAME=bellanapoli
# DB_SSL=true

# ─── Servidor ──────────────────────────────────────────
PORT=4000

# ─── Seguridad ─────────────────────────────────────────
# Cambia esto por una cadena larga y aleatoria en produccion
JWT_SECRET=cambia_esto_por_algo_largo_y_secreto_2025

# Credenciales del primer administrador (se crean al inicializar la BD)
ADMIN_USER=admin
ADMIN_PASSWORD=pizza2025
